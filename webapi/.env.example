# Ambiente OpenTurn (serviços Windows: sufixo do nome do serviço). Valores: PRD | DEV
NODE_ENV=DEV
# Prefixo de isolamento (DEV | PRD): filas Rabbit, chaves/canais Redis, pub/sub (ex.: refresh de rotina).
# Deve ser o mesmo no worker para invalidação de cache cruzada.
# Se omitido, é derivado de NODE_ENV (DEV/development/test → DEV; production/PRD → PRD).
# Obrigatório quando múltiplas instâncias compartilham o mesmo broker/Redis.
# OPENTURN_DEPLOYMENT_PREFIX=DEV

# Runtime — aponta para o PgBouncer (transaction mode, porta 6432).
# ?pgbouncer=true desativa prepared statements (incompatíveis com transaction pooling).
# connection_limit=2 é suficiente; o pool real é gerenciado pelo PgBouncer.
# pool_timeout (segundos) controla quanto o Prisma espera por uma conexão livre antes de
# lançar P2024 (Timed out fetching a new connection); some connection_limit da webapi ao
# connection_limit do worker (x WORKER_INSTANCES) e mantenha a soma abaixo do pool_size
# do PgBouncer / max_connections do Postgres.
DATABASE_URL="postgresql://user:password@localhost:6432/openturn_db?schema=public&pgbouncer=true&connection_limit=2&pool_timeout=20"
# Conexão direta ao PostgreSQL — usada pelo Prisma CLI (migrate dev, db push, studio).
# Nunca usar esta variável em runtime; migrations precisam de conexão com estado de sessão.
DATABASE_URL_DIRECT="postgresql://user:password@localhost:5432/openturn_db?schema=public"
JWT_SECRET="your-secret-key"
PORT=8000
PORTWS=8001

# URL base da própria API (com /api), usada para disparar webhooks de rotina a partir do monitor ControlID
# Ex.: https://staging.schoolguard.com.br/api
API_URL=

# Redis (console, realtime e cache)
REDIS_HOST=localhost
REDIS_PORT=6379
# Opcionais (Redis 6+ ACL). Senhas com caracteres especiais: use aspas, ex.: REDIS_PASSWORD="sua*senha"
REDIS_USERNAME=
REDIS_PASSWORD=
# ACL: ~* = chaves; &* = canais pub/sub (obrigatório para BullMQ, rotina:console, adapter Socket.IO). Sem &* aparece NOPERM no subscribe.
# redis-cli -u redis://127.0.0.1:6379 -a '(sua-adminpass)' ACL SETUSER openturn on >openturn_secret ~* &* +@all -@dangerous
# Depois use REDIS_USERNAME=openturn REDIS_PASSWORD=openturn_secret

# Monitor global (snapshot Redis): fuso para buckets das séries; cron usa MONITOR_CRON_TZ (ex. America/Sao_Paulo)
MONITOR_SNAPSHOT_TZ=America/Sao_Paulo
MONITOR_CRON_TZ=America/Sao_Paulo

# Limites de execução
ROTINA_MAX_CONCURRENT_MANUAL=10
# TTL do marcador Redis rotina:pending:{exeId} após enqueue (UX; worker remove ao consumir)
ROTINA_PENDING_TTL_SEC=86400
# Minutos parado em AGUARDANDO_LOCK_SERIAL para o watchdog (serial-lock-watchdog.service.ts) alertar
SERIAL_LOCK_WATCHDOG_STALE_MINUTES=10

# RabbitMQ (orquestração de jobs por instituição)
RABBIT_URL=amqp://guest:guest@localhost:5672
RABBIT_MGMT_URL=http://localhost:15672
RABBIT_MGMT_USER=guest
RABBIT_MGMT_PASS=guest

# OpenAI (módulo IA)
OPENAI_API_KEY=sk-...

# Remote Gateway
REMOTE_GATEWAY_URL=https://staging.schoolguard.com.br
RELAY_INTERNAL_TOKEN=openturn-internal-secret-token

# Recuperação de senha (Brevo) — APP_URL = URL pública do frontend (Next.js), sem barra final
BREVO_API_KEY=
APP_URL=https://staging.schoolguard.com.br
EMAIL_FROM=noreply@schoolguard.com.br
EMAIL_FROM_NAME=SchoolGuard

# Validação de rosto em fotos (Gennera sync / Control iD). Obrigatório: 0=desativado, 1=ativado
FACE_VALIDATION_ENABLED=1

# Resiliência ControlID: circuit breaker por equipamento (host:porta) evita martelar um
# dispositivo offline a cada requisição, e o teto de sessão evita travar o handler HTTP
# esperando o login do equipamento.
# Falhas consecutivas de login para abrir o circuito (rejeita rápido até o cooldown expirar).
CONTROLID_CIRCUIT_FAILURE_THRESHOLD=3
# Tempo (ms) que o circuito fica aberto após atingir o limite de falhas.
CONTROLID_CIRCUIT_COOLDOWN_MS=60000
# Teto absoluto (ms) para ensureSession/login de um equipamento ControlID por chamada.
CONTROLID_SESSION_HARD_TIMEOUT_MS=12000

# URL pública do webapp (Next.js) — usada para gerar QR Code do wizard de foto no backend.
# Sem barra final. Exemplo: https://app.schoolguard.com.br
PUBLIC_WEBAPP_URL=https://app.exemplo.com.br
